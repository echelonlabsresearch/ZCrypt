/-
  Proof.lean — SOUNDNESS OF THE AUTO-EXTRACTED RUST.

  `ZcryptVmCore.lean` was generated by Charon + Aeneas directly from
  `formal/extract/vm-core/src/lib.rs` (the value-integrity core of the shield-transfer
  VM). Here we prove, against that MACHINE-GENERATED model, that an accepted transfer
  creates no value. This links the actual Rust source to a kernel-checked theorem.
-/
import Aeneas
import ZcryptVmCore

open Aeneas Std Result
open zcrypt_vm_core

set_option maxHeartbeats 4000000

/-- If the extracted `conservation_ok` returns `true`, value is conserved exactly over
    the integers: total inputs equal total outputs plus fee (the U64 additions inside it
    provably did not overflow). -/
theorem conservation_ok_sound
    (in0 in1 out0 out1 fee : U64)
    (h : conservation_ok in0 in1 out0 out1 fee = ok true) :
    in0.val + in1.val = out0.val + out1.val + fee.val := by
  unfold conservation_ok at h
  have e1 := UScalar.add_equiv in0 in1
  cases hi0 : in0 + in1 with
  | fail e => simp [hi0] at h
  | div => simp [hi0] at h
  | ok i =>
    rw [hi0] at e1; simp only [hi0, bind_ok, bind_tc_ok] at h
    obtain ⟨_, ei, _⟩ := e1
    have e2 := UScalar.add_equiv out0 out1
    cases hi1 : out0 + out1 with
    | fail e => simp [hi1] at h
    | div => simp [hi1] at h
    | ok i1 =>
      rw [hi1] at e2; simp only [hi1, bind_ok, bind_tc_ok] at h
      obtain ⟨_, ei1, _⟩ := e2
      have e3 := UScalar.add_equiv i1 fee
      cases hi2 : i1 + fee with
      | fail e => simp [hi2] at h
      | div => simp [hi2] at h
      | ok i2 =>
        rw [hi2] at e3; simp only [hi2, bind_ok, bind_tc_ok] at h
        obtain ⟨_, ei2, _⟩ := e3
        simp only [ok.injEq, decide_eq_true_eq] at h
        subst h
        omega

/-- SOUNDNESS OF THE EXTRACTED RUST (no inflation): if the extracted VM ACCEPTS a
    transfer, total outputs never exceed total inputs. -/
theorem accepts_no_inflation
    (in0 in1 out0 out1 fee a_in0 a_in1 a_out0 a_out1 : U64)
    (h : accepts in0 in1 out0 out1 fee a_in0 a_in1 a_out0 a_out1 = ok true) :
    out0.val + out1.val ≤ in0.val + in1.val := by
  -- `range_ok` and `single_asset_ok` never fail (pure comparisons), and for `accepts`
  -- to be `ok true` the middle `conservation_ok` must itself be `ok true`.
  have hc : conservation_ok in0 in1 out0 out1 fee = ok true := by
    unfold accepts at h
    revert h
    cases hr : range_ok in0 in1 out0 out1 fee with
    | fail e => simp
    | div => simp
    | ok b =>
      cases b with
      | false => simp [hr]
      | true =>
        simp only [hr, bind_ok, bind_tc_ok, if_true]
        cases hcv : conservation_ok in0 in1 out0 out1 fee with
        | fail e => simp
        | div => simp
        | ok b1 =>
          cases b1 with
          | false => simp [hcv]
          | true => intro _; rfl
  have := conservation_ok_sound in0 in1 out0 out1 fee hc
  omega
