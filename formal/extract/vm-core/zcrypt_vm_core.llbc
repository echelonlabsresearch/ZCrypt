{"charon_version":"0.1.232","translated":{"crate_name":"zcrypt_vm_core","options":{"ullbc":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":null,"monomorphize":false,"monomorphize_mut":null,"start_from":[],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":[],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":null,"no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"skip_borrowck":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"aarch64-apple-darwin","value":{"target_pointer_size":8,"is_little_endian":true,"c_enum_min_size":4,"primitive_alignments":[{"key":"Bool","value":1},{"key":{"Int":"I8"},"value":1},{"key":{"Int":"I16"},"value":2},{"key":{"Int":"I32"},"value":4},{"key":{"Int":"I64"},"value":8},{"key":{"Int":"I128"},"value":16},{"key":{"Int":"Isize"},"value":8},{"key":{"UInt":"U8"},"value":1},{"key":{"UInt":"U16"},"value":2},{"key":{"UInt":"U32"},"value":4},{"key":{"UInt":"U64"},"value":8},{"key":{"UInt":"U128"},"value":16},{"key":{"UInt":"Usize"},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"zcrypt_vm_core","contents":"//! zcrypt_vm_core: the pure, EXTRACTABLE arithmetic core of the shield-transfer VM,\n//! a faithful carve-out of `impl/shield/src/zvm.rs::execute`, with NO external crates and\n//! NO generics, so the Charon -> Aeneas -> Lean 4 pipeline can process it end to end.\n//!\n//! N_IN = N_OUT = 2, as in the circuit. The Poseidon2-dependent arms of `execute`\n//! (OP_CHECK_MEMBERSHIP, OP_COMPUTE_NULLIFIERS, OP_COMPUTE_OUTPUTS) are intentionally\n//! excluded here: they call the hash from an external crate and are the documented\n//! extraction wall. What remains is the value-integrity logic, which is what the\n//! soundness theorems in `formal/Zcrypt/Spec.lean` are about.\n\n/// Per-coin value cap, 2^52 (MAX_COIN_VALUE in shield: two 26-bit limbs).\npub const COIN_CAP: u64 = 4503599627370496;\n/// Fee cap, 2^26 (the fee is single-limb).\npub const FEE_CAP: u64 = 67108864;\n\n/// OP_CHECK_RANGE (zvm.rs:89): every value is within its cap.\npub fn range_ok(in0: u64, in1: u64, out0: u64, out1: u64, fee: u64) -> bool {\n    in0 < COIN_CAP && in1 < COIN_CAP && out0 < COIN_CAP && out1 < COIN_CAP && fee < FEE_CAP\n}\n\n/// OP_CHECK_CONSERVATION (zvm.rs:140): Sum(inputs) == Sum(outputs) + fee.\npub fn conservation_ok(in0: u64, in1: u64, out0: u64, out1: u64, fee: u64) -> bool {\n    in0 + in1 == out0 + out1 + fee\n}\n\n/// OP_CHECK_SINGLE_ASSET (zvm.rs:128): all inputs and outputs share one asset id.\npub fn single_asset_ok(a_in0: u64, a_in1: u64, a_out0: u64, a_out1: u64) -> bool {\n    a_in1 == a_in0 && a_out0 == a_in0 && a_out1 == a_in0\n}\n\n/// The VM accepts a single-asset transfer iff range + conservation + single-asset hold.\npub fn accepts(\n    in0: u64,\n    in1: u64,\n    out0: u64,\n    out1: u64,\n    fee: u64,\n    a_in0: u64,\n    a_in1: u64,\n    a_out0: u64,\n    a_out1: u64,\n) -> bool {\n    range_ok(in0, in1, out0, out1, fee)\n        && conservation_ok(in0, in1, out0, out1, fee)\n        && single_asset_ok(a_in0, a_in1, a_out0, a_out1)\n}\n"}],"item_names":[{"key":{"Global":0},"value":[{"Ident":["zcrypt_vm_core",0]},{"Ident":["COIN_CAP",0]}]},{"key":{"Global":1},"value":[{"Ident":["zcrypt_vm_core",0]},{"Ident":["FEE_CAP",0]}]},{"key":{"Fun":0},"value":[{"Ident":["zcrypt_vm_core",0]},{"Ident":["range_ok",0]}]},{"key":{"Fun":1},"value":[{"Ident":["zcrypt_vm_core",0]},{"Ident":["conservation_ok",0]}]},{"key":{"Fun":2},"value":[{"Ident":["zcrypt_vm_core",0]},{"Ident":["single_asset_ok",0]}]},{"key":{"Fun":3},"value":[{"Ident":["zcrypt_vm_core",0]},{"Ident":["accepts",0]}]},{"key":{"Fun":4},"value":[{"Ident":["zcrypt_vm_core",0]},{"Ident":["COIN_CAP",0]}]},{"key":{"Fun":5},"value":[{"Ident":["zcrypt_vm_core",0]},{"Ident":["FEE_CAP",0]}]}],"assoc_item_names":[],"short_names":[{"key":{"Fun":2},"value":[{"Ident":["single_asset_ok",0]}]},{"key":{"Fun":3},"value":[{"Ident":["accepts",0]}]},{"key":{"Global":1},"value":[{"Ident":["FEE_CAP",0]}]},{"key":{"Fun":5},"value":[{"Ident":["FEE_CAP",0]}]},{"key":{"Global":0},"value":[{"Ident":["COIN_CAP",0]}]},{"key":{"Fun":4},"value":[{"Ident":["COIN_CAP",0]}]},{"key":{"Fun":1},"value":[{"Ident":["conservation_ok",0]}]},{"key":{"Fun":0},"value":[{"Ident":["range_ok",0]}]}],"type_decls":[],"fun_decls":[{"def_id":0,"item_meta":{"name":[{"Ident":["zcrypt_vm_core",0]},{"Ident":["range_ok",0]}],"span":{"data":{"file_id":0,"beg":{"line":17,"col":0},"end":{"line":19,"col":1}},"generated_from_span":null},"source_text":"pub fn range_ok(in0: u64, in1: u64, out0: u64, out1: u64, fee: u64) -> bool {\n    in0 < COIN_CAP && in1 < COIN_CAP && out0 < COIN_CAP && out1 < COIN_CAP && fee < FEE_CAP\n}","attr_info":{"attributes":[{"DocComment":" OP_CHECK_RANGE (zvm.rs:89): every value is within its cap."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null,"diagnostic_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraint