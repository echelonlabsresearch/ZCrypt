{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZCrypt Wallet",
  "version": "0.2.1",
  "identifier": "io.zcrypt.wallet",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZCrypt Wallet",
        "width": 1280,
        "height": 920,
        "minWidth": 1000,
        "minHeight": 850,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "category": "Finance",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": null
    },
    "fileAssociations": [
      {
        "ext": [
          "zcrypt"
        ],
        "name": "ZCrypt payment",
        "description": "A ZCrypt bearer coin, stealth note or payment receipt",
        "mimeType": "application/x-zcrypt",
        "role": "Viewer",
        "rank": "Owner",
        "contentTypes": ["io.zcrypt.payment"]
      }
    ],
    "iOS": {
      "developmentTeam": "HKWCZHR3TM",
      "minimumSystemVersion": "15.0",
      "bundleVersion": "4"
    }
  }
}
