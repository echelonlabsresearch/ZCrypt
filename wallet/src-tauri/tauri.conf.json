{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZCrypt Wallet",
  "version": "0.1.0",
  "identifier": "io.zcrypt.wallet",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZCrypt Wallet",
        "width": 1280,
        "height": 920,
        "minWidth": 1000,
        "minHeight": 850,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": false,
    "category": "Finance"
  }
}
