# You do NOT need this file to join the public chain — the defaults in
# docker-compose.validator.yml already point at the foundation. Just run:
#
#   docker compose -f docker-compose.validator.yml up -d
#
# Copy this to `.env` ONLY to join a different chain (e.g. a local test foundation):
#
#   cp validator.env.example .env
#
# Point at the foundation you want to join (genesis is downloaded; nothing else to set):
# GENESIS_URL=http://host.docker.internal:8000/genesis.json   # where the genesis.json is hosted
# SEED_RPC=http://host.docker.internal:36657                  # a node's RPC (for peer discovery)
# SEED_P2P_HOST=host.docker.internal                          # that node's P2P host
# SEED_P2P_PORT=26656
# Or skip discovery with a full seed string:
# ZCRYPT_SEEDS=<node_id>@host:26656

# Build a devnet abci locally instead of pulling the published image:
# ABCI_FEATURES=devnet          # (default) enables the Fund faucet used in testing
# ZCRYPT_ABCI_IMAGE=chain-abci  # use a locally built image tag

# Host ports for this validator:
# VALIDATOR_RPC_PORT=56657
# VALIDATOR_P2P_PORT=56656
# CHAIN_ID=zcrypt-devnet
