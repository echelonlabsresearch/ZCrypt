# You do NOT need this file to join the public chain: the defaults in
# docker-compose.validator.yml already point at the foundation. Just run:
#
#   docker compose -f docker-compose.validator.yml up -d
#
# Copy this to `.env` to pin the published genesis hash (recommended) or to join a
# different chain (e.g. a local test foundation):
#
#   cp validator.env.example .env

# Your validator identity, from the wallet: Rewards, Run a validator, Node setup, "Copy the
# .env line". Paste the whole line here BEFORE the first start. It is the node's signing key
# (base64 of priv_validator_key.json): keep this file private. With it, the wallet bonds and
# unbonds the node by itself; without it the node generates a key you would have to sign with.
# VALIDATOR_KEY=

# The SHA-256 of genesis.json the foundation published (chain/README-validator.md). When
# set, the node refuses to start on a genesis whose hash differs.
# GENESIS_SHA256=

# Point at the foundation you want to join (genesis is downloaded; nothing else to set):
# GENESIS_URL=http://host.docker.internal:8000/genesis.json   # where the genesis.json is hosted
# SEED_RPC=http://host.docker.internal:36657                  # a node's RPC (for peer discovery)
# SEED_P2P_HOST=host.docker.internal                          # that node's P2P host
# SEED_P2P_PORT=26656
# Or skip discovery with a full seed string:
# ZCRYPT_SEEDS=<node_id>@host:26656

# Build a devnet abci locally instead of pulling the published, digest-pinned image:
# ABCI_FEATURES=devnet          # enables the Fund faucet used in testing (NEVER on mainnet)
# ZCRYPT_ABCI_IMAGE=chain-abci  # use a locally built image tag

# Host ports for this validator. The RPC is bound to localhost by default; set
# VALIDATOR_RPC_BIND=0.0.0.0:56657 only if you deliberately want an open, unauthenticated RPC.
# VALIDATOR_RPC_BIND=127.0.0.1:56657
# VALIDATOR_P2P_PORT=56656
# CHAIN_ID=zcrypt-devnet
